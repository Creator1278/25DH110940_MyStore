@model _25DH110940_MyStore.Models.ViewModel.ProductionSearchVM

@{
    ViewBag.Title = "Search Product";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Search</title>
    <style>
        .search-container, .order-container {
            padding-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

       
    </style>
</head>
<body>
    <!-- Form tim kiem -->
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
            {
                <div class="form-group search-container">
                    @Html.TextBoxFor(m => m.SearchTerm, new
               {
                   @class = "form-control",
                   placeholder = "Nhap ten, mo ta chung loai san pham"
               })
                    @* bo sung them trg tim kiem theo khoang gia *@
                    @Html.TextBoxFor(m => m.MinPrice, new
{
@class = "form-control",
 placeholder = "Nhap gia toi thieu",
 type = "number",
})
                    @Html.TextBoxFor(m => m.MaxPrice, new
               {
                   @class = "form-control",
                     placeholder = "Nhap gia toi da",
                     type = "number",
               })
                    <button type="submit" class="btn btn-primary">Tim kiem</button>
                </div>

      <!--Tuy chon sap xxep-->
<div class="form-group order-container">
    Sap xep theo:
     @Html.ActionLink("Ten tang dan", "Index",
    new { orderBy = "name_asc", searchTerm = Model.SearchTerm,minPrice = Model.MinPrice, maxPrice= Model.MaxPrice }, null)
    |
    @Html.ActionLink("Ten giam dan", "Index",
    new { orderBy = "name_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, null)
    |
    @Html.ActionLink("Gia tang dan", "Index",
    new { orderBy = "price_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, null)
    |
    @Html.ActionLink("Gia giam dan", "Index",
    new { orderBy = "price_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, null)
</div>
            }

    @* Form ket qua tim kiem *@
    @Html.Partial("PVListProduct",Model)
</body>
</html>



