@model _25DH110940_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XOA DANH MUC</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    <hr />
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <h4>Are you sure you want to delete this?</h4>
        </div>
    </div>
    <div class="form-group">
        <div class="control-label col-md-2">Ten danh muc</div>
        <div class="col-md-10">
            @Html.DisplayFor(model => model.CategoryName)

        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xoa" class="btn btn-primary" /> 
                @Html.ActionLink("Quay lai danh sach", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>
        }
